[Unit]
Description=Factored AI LLM API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/factored-ai

Environment=MODEL_ID=Josephgflowers/FinR1-llama-8b-multi-language-thinking
Environment=HF_HOME=/opt/factored-ai/.cache/huggingface
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/pytorch/bin/python -m uvicorn backend.app:app --host 0.0.0.0 --port 8000 --workers 1

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target