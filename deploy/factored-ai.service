[Unit]
Description=Factored AI Backend API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/factored-ai

Environment=AWS_REGION=us-east-1
Environment=OPENAI_SECRET_NAME=factored/openai/api-key
Environment=OPENAI_MODEL=gpt-5.6-luna
Environment=EVIDENCE_BUCKET=YOUR-EVIDENCE-BUCKET-NAME
Environment=ORGANIZER_S3_SECRET_NAME=factored/organizer-s3/read-only
Environment=DATABASE_SECRET_NAME=factored/database/url
Environment=E5_MODEL=intfloat/multilingual-e5-base
Environment=FAISS_INDEX_PATH=/opt/factored-ai/retrieval_assets/complaints.faiss
Environment=FAISS_MAPPING_PATH=/opt/factored-ai/retrieval_assets/complaint_ids.json
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/factored-ai/.venv/bin/python -m uvicorn backend.app:app --host 0.0.0.0 --port 8000 --workers 1

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target