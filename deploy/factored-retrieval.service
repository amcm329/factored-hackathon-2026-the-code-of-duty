[Unit]
Description=Factored AI Retrieval API
After=network.target

[Service]
Type=simple
User=ssm-user
Group=ssm-user
WorkingDirectory=/opt/factored-ai
EnvironmentFile=/etc/factored-retrieval.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/opt/factored-ai/.venv/bin/python -m retrieval.sync_assets
ExecStart=/opt/factored-ai/.venv/bin/python -m uvicorn retrieval.app:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
