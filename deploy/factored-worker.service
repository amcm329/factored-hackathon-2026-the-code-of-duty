[Unit]
Description=Factored AI Worker API
After=network.target

[Service]
Type=simple
User=ssm-user
Group=ssm-user
WorkingDirectory=/opt/factored-ai
EnvironmentFile=/etc/factored-worker.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/factored-ai/.venv/bin/python -m uvicorn backend.worker_app:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
